# Copy to .env.local and fill in. Nothing here is needed for the built-in demo.

# Reads your forms, writes the draft answers, matches saved facts.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional. Defaults to openai/gpt-oss-120b (strict JSON output). openai/gpt-oss-20b is faster.
# GROQ_MODEL=openai/gpt-oss-120b

# The ElevenLabs agent that runs the voice interview. See /setup for what to paste into it.
ELEVENLABS_AGENT_ID=

# Optional. Only needed if you make the agent private (recommended once deployed).
# Stays on the server; the browser gets a short-lived token instead.
ELEVENLABS_API_KEY=

# Optional: sign in with Google through Neon Auth. Enable Auth on your Neon project and copy its Auth URL.
# Cookie secret: at least 32 random characters, e.g.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Optional: read private Google Forms (forms you own or can edit). Needs a Google client of your own.
# Redirect URI to register: http://localhost:3100/api/forms/callback. Steps are on /setup.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# At least 32 random characters. Encrypts the Google Forms cookie.
AUTH_SECRET=
# Optional: the public address, when the app runs behind a proxy.
# APP_URL=https://your-domain

# Optional: a Postgres connection string (for example from neon.tech). Only used to sync saved facts.
DATABASE_URL=

# Optional: a GitHub token (no scopes needed) to raise the rate limit when reading a GitHub profile in onboarding.
GITHUB_TOKEN=

# Optional: connect a GitHub account (private repos included) from the Profile screen. Create an OAuth App at
# github.com/settings/developers, tick "Enable Device Flow", and paste its Client ID. No secret is needed.
GITHUB_CLIENT_ID=
